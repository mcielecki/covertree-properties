# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=covertree
POSTGRES_PASSWORD=covertree
POSTGRES_DB=covertree

# --- API ---
DATABASE_URL=postgresql://covertree:covertree@localhost:5432/covertree
# Required unless WEATHER_PROVIDER=fake. Get one at https://weatherstack.com
WEATHERSTACK_API_KEY=
# Set to http://api.weatherstack.com if your plan rejects HTTPS (error 105).
WEATHERSTACK_BASE_URL=https://api.weatherstack.com
WEATHERSTACK_TIMEOUT_MS=5000
# weatherstack | fake
WEATHER_PROVIDER=weatherstack
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Web (build-time) ---
VITE_GRAPHQL_URL=http://localhost:4000/graphql
